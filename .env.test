TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=silent
APP_KEY=test-app-key-0000000000000000000000
NODE_ENV=test

# Banco de testes: SQLite em memória (rápido, autocontido).
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test
DB_DATABASE=oficina_test

# Autenticação JWT (segredo só de teste).
JWT_SECRET=test-jwt-secret
JWT_EXPIRES_IN=1h

# Webhooks (segredo só de teste).
WEBHOOK_SECRET=test-webhook-secret

# Notificação: sempre log nos testes (sem SMTP real).
NOTIFICACAO_DRIVER=log
