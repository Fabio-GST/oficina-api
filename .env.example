TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# Banco de dados (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=oficina

# Autenticação JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1h

# Webhooks (segredo compartilhado com sistemas externos)
WEBHOOK_SECRET=troque-este-segredo-de-webhook

# Notificação ao cliente: "log" (padrão) ou "email" (SMTP real)
NOTIFICACAO_DRIVER=log
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=oficina@exemplo.com
# EMAIL_ALMOXARIFE=almoxarife@exemplo.com
